{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ytm-bridge",
  "description": "Permite que el puente inyectado en YouTube Music envíe el estado del reproductor a la aplicación.",
  "windows": ["main"],
  "webviews": ["ytm"],
  "remote": {
    "urls": ["https://music.youtube.com", "https://music.youtube.com/*"]
  },
  "permissions": ["core:event:allow-emit"]
}
